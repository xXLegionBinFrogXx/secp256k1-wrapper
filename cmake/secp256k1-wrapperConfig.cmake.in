@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/secp256k1-wrapperTargets.cmake")

# Friendly aliases for consumers:
if(NOT TARGET secp256k1-wrapper AND TARGET secp256k1-wrapper::secp256k1-wrapper)
  add_library(secp256k1-wrapper ALIAS secp256k1-wrapper::secp256k1-wrapper)
  get_target_property(_sw_type secp256k1-wrapper::secp256k1-wrapper TYPE)
  if(_sw_type STREQUAL "SHARED_LIBRARY")
    add_library(secp256k1-wrapper::shared ALIAS secp256k1-wrapper::secp256k1-wrapper)
  else()
    add_library(secp256k1-wrapper::static ALIAS secp256k1-wrapper::secp256k1-wrapper)
  endif()
  unset(_sw_type)
endif()